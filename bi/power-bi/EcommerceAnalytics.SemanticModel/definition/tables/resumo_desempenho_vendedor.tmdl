table resumo_desempenho_vendedor
	lineageTag: 63e685b5-1f81-403f-aada-94418d3132c2

	measure 'Vendedores Ativos' = COUNTROWS(resumo_desempenho_vendedor)
		formatString: #,##0
		lineageTag: 0f8f9b0d-8212-4f17-8b5c-78c7ac37ae98

	measure 'Valor Bruto Vendedores' = SUM(resumo_desempenho_vendedor[valor_bruto])
		formatString: R$ #,##0.00
		lineageTag: 1f5d0f97-43cd-4fbe-8030-fea3b874605e

	measure 'Participação Top 10 %' = DIVIDE(SUMX(FILTER(resumo_desempenho_vendedor, resumo_desempenho_vendedor[posicao_valor_itens] <= 10), resumo_desempenho_vendedor[valor_itens]), SUM(resumo_desempenho_vendedor[valor_itens]))
		formatString: 0.00 %
		lineageTag: 691d41da-f928-4d4e-a3ce-2dbe7fdd6314

	measure 'HHI Base Observada' = MAX(resumo_desempenho_vendedor[hhi_base_observada])
		formatString: 0.000000
		lineageTag: cce6628d-f5a5-4f54-8c0c-eb6f401d3073

