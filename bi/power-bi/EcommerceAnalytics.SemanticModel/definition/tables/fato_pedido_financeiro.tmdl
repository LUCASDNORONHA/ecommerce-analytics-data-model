table fato_pedido_financeiro
	lineageTag: c836149d-c996-4a83-9814-409c4fb849a3

	measure Pedidos = COUNTROWS(fato_pedido_financeiro)
		formatString: #,##0
		lineageTag: ca03c192-4221-46cc-95eb-34343e00053e

	measure 'Pedidos Entregues' = CALCULATE([Pedidos], fato_pedido_financeiro[status_pedido] = "delivered")
		formatString: #,##0
		lineageTag: bb88e48c-cafc-49c4-bdd6-6f4f8a70987f

	measure 'Pedidos Entregues Completos' = CALCULATE([Pedidos], fato_pedido_financeiro[status_pedido] = "delivered", fato_pedido_financeiro[possui_itens] = TRUE(), fato_pedido_financeiro[possui_pagamentos] = TRUE())
		formatString: #,##0
		lineageTag: fb243a8a-f5ef-4dda-a86f-125eafe8b072

	measure 'Pedidos Cancelados' = CALCULATE([Pedidos], fato_pedido_financeiro[status_pedido] = "canceled")
		formatString: #,##0
		lineageTag: dedfa91c-1580-4dcb-a4d5-63c24ce68fc9

	measure 'Taxa Cancelamento %' = DIVIDE([Pedidos Cancelados], [Pedidos])
		formatString: 0.00 %
		lineageTag: 73bcfacb-517e-4911-8ccc-ee66a690f3c4

	measure 'Valor Itens Entregues' = CALCULATE(SUM(fato_pedido_financeiro[valor_itens]), fato_pedido_financeiro[status_pedido] = "delivered", fato_pedido_financeiro[possui_itens] = TRUE(), fato_pedido_financeiro[possui_pagamentos] = TRUE())
		formatString: R$ #,##0.00
		lineageTag: 0c3e0d38-7a34-48cc-86c8-0768a5903296

	measure 'Valor Frete Entregue' = CALCULATE(SUM(fato_pedido_financeiro[valor_frete]), fato_pedido_financeiro[status_pedido] = "delivered", fato_pedido_financeiro[possui_itens] = TRUE(), fato_pedido_financeiro[possui_pagamentos] = TRUE())
		formatString: R$ #,##0.00
		lineageTag: 394e47eb-f3cc-4adf-9cdc-918e17d35931

	measure 'Valor Bruto Entregue' = CALCULATE(SUM(fato_pedido_financeiro[valor_bruto]), fato_pedido_financeiro[status_pedido] = "delivered", fato_pedido_financeiro[possui_itens] = TRUE(), fato_pedido_financeiro[possui_pagamentos] = TRUE())
		formatString: R$ #,##0.00
		lineageTag: fc68e0ec-6899-4e59-8b44-de8055c51a0c

	measure 'Valor Pago Registrado Entregue' = CALCULATE(SUM(fato_pedido_financeiro[valor_pago_registrado]), fato_pedido_financeiro[status_pedido] = "delivered", fato_pedido_financeiro[possui_itens] = TRUE(), fato_pedido_financeiro[possui_pagamentos] = TRUE())
		formatString: R$ #,##0.00
		lineageTag: 0d8a7bbb-3809-41f4-9440-c5987f0a679c

	measure 'Diferença Reconciliação Entregue' = CALCULATE(SUM(fato_pedido_financeiro[diferenca_reconciliacao]), fato_pedido_financeiro[status_pedido] = "delivered", fato_pedido_financeiro[possui_itens] = TRUE(), fato_pedido_financeiro[possui_pagamentos] = TRUE())
		formatString: R$ #,##0.00
		lineageTag: 1794dc0f-b00e-44e2-8b88-c50a5bcba7d0

	measure 'Ticket Médio Bruto' = DIVIDE([Valor Bruto Entregue], [Pedidos Entregues Completos])
		formatString: R$ #,##0.00
		lineageTag: c84fca2e-b15f-47bd-920c-7330d1f327ee

	measure 'Participação Frete %' = DIVIDE([Valor Frete Entregue], [Valor Bruto Entregue])
		formatString: 0.00 %
		lineageTag: 5aaca84e-8a4d-4917-80b3-2ef6de373077

	measure 'Taxa Atraso Entrega %' = DIVIDE(CALCULATE([Pedidos], fato_pedido_financeiro[status_pedido] = "delivered", fato_pedido_financeiro[entrega_atrasada] = TRUE()), [Pedidos Entregues])
		formatString: 0.00 %
		lineageTag: 4affb19c-2111-4578-93d7-9873aaa6402c

	measure 'Nota Média' = CALCULATE(AVERAGE(fato_pedido_financeiro[nota_media_pedido]), fato_pedido_financeiro[possui_avaliacao] = TRUE())
		formatString: 0.00
		lineageTag: 108c99a8-1294-4e68-9462-54e8207ef7b4

	measure 'Taxa Avaliação Negativa %' = DIVIDE(CALCULATE([Pedidos], fato_pedido_financeiro[possui_avaliacao] = TRUE(), fato_pedido_financeiro[nota_media_pedido] <= 2), CALCULATE([Pedidos], fato_pedido_financeiro[possui_avaliacao] = TRUE()))
		formatString: 0.00 %
		lineageTag: 63d60abf-6feb-4462-886a-e28543f38f5f

