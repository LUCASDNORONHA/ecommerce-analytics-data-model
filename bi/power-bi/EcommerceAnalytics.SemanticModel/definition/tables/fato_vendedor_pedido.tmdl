table fato_vendedor_pedido
	lineageTag: 9f904edc-1025-4492-aa38-2db310136e12

	measure 'Participações Vendedor-Pedido' = COUNTROWS(fato_vendedor_pedido)
		formatString: #,##0
		lineageTag: b06adf2d-dc59-446d-9102-cae58e9c3b54

	measure 'Pedidos Distintos Vendedor' = DISTINCTCOUNT(fato_vendedor_pedido[id_pedido])
		formatString: #,##0
		lineageTag: f7e4e871-5864-48d3-a27c-927f111efba3

	measure 'Valor Bruto Vendedor-Pedido' = SUM(fato_vendedor_pedido[valor_bruto])
		formatString: R$ #,##0.00
		lineageTag: 9113d711-360c-436d-8f4e-c3bf57017dba

	measure 'Taxa Itens Após Limite %' = DIVIDE(SUM(fato_vendedor_pedido[itens_enviados_apos_limite]), SUM(fato_vendedor_pedido[itens_com_envio_observado]))
		formatString: 0.00 %
		lineageTag: 04121c75-c2e9-484c-9c02-97c2678c8c8d

	measure 'Taxa Participações com Item Após Limite %' = DIVIDE(CALCULATE([Participações Vendedor-Pedido], fato_vendedor_pedido[possui_item_enviado_apos_limite] = TRUE()), [Participações Vendedor-Pedido])
		formatString: 0.00 %
		lineageTag: 14028092-6d28-467e-85a4-03c3a7bcd1cf

	measure 'Taxa Atraso Associado %' = DIVIDE(CALCULATE([Participações Vendedor-Pedido], fato_vendedor_pedido[entrega_atrasada_associada] = TRUE()), CALCULATE([Participações Vendedor-Pedido], NOT ISBLANK(fato_vendedor_pedido[entrega_atrasada_associada])))
		formatString: 0.00 %
		lineageTag: 844f1991-4028-4e50-8464-445ef2a0d290

	measure 'Nota Média Associada' = AVERAGE(fato_vendedor_pedido[nota_media_associada])
		formatString: 0.00
		lineageTag: de8411c9-51b1-4c4c-b9d4-e334891841b2

	measure 'Taxa Avaliação Negativa Associada %' = DIVIDE(CALCULATE([Participações Vendedor-Pedido], fato_vendedor_pedido[nota_media_associada] <= 2), CALCULATE([Participações Vendedor-Pedido], NOT ISBLANK(fato_vendedor_pedido[nota_media_associada])))
		formatString: 0.00 %
		lineageTag: 7e01a19a-8966-4d88-8eda-bdeb77317e94

